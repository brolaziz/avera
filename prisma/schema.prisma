generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  order    Int       @default(0)
  visible  Boolean   @default(true)
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @default("")
  price       Int
  oldPrice    Int?
  tag         String      @default("")
  image       String      @default("")
  images      Json        @default("[]")
  stock       Int         @default(0)
  available   Boolean     @default(true)
  colors      Json        @default("[]")
  specs       Json        @default("[]")
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  customer  String
  phone     String
  address   String
  total     Int
  status    String      @default("kutilmoqda")
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  qty       Int
  price     Int
}

model PaymentSettings {
  id               String @id @default("default")
  cardNumber       String @default("8600 1234 5678 9012")
  cardOwner        String @default("AVERA SHOP")
  telegramUsername String @default("@avera_admin")
}

model SiteSettings {
  id String @id @default("default")

  // Hero / banner — admin paneldan boshqariladi
  heroBadge    String @default("")
  heroTitle    String @default("Tabiiy charm sumkalar kolleksiyasi")
  heroSubtitle String @default("")
  heroDiscount String @default("")
  heroImage    String @default("")
  heroCtaText  String @default("Xarid qilish")
  heroCtaLink  String @default("/katalog")

  // Mashhur mahsulotlar bo'limi
  featuredTitle String @default("Mashhur mahsulotlar")

  // Yetkazish
  freeDeliveryMin Int @default(500000)

  // Aloqa ma'lumotlari
  contactPhone String @default("")
  telegram     String @default("")
  instagram    String @default("")
  address      String @default("")
  workHours    String @default("")

  // Footer
  footerAbout String @default("")
}

model FooterSection {
  id      String       @id @default(cuid())
  title   String
  order   Int          @default(0)
  visible Boolean      @default(true)
  links   FooterLink[]
}

model FooterLink {
  id        String        @id @default(cuid())
  sectionId String
  section   FooterSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String
  url       String        @default("#")
  order     Int           @default(0)
  visible   Boolean       @default(true)
}

model PartnerRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  telegram  String   @default("")
  message   String   @default("")
  status    String   @default("yangi")
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
